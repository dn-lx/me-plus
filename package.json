{
  "name": "me-plus",
  "version": "0.3.1",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @me-plus/web dev",
    "dev:mobile": "pnpm --filter @me-plus/mobile start",
    "build:web": "pnpm --filter @me-plus/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm test:finance && pnpm test:health && pnpm typecheck",
    "test:finance": "node --experimental-strip-types --test tests/n26-account-identity.test.mjs",
    "test:health": "node --experimental-strip-types --test tests/health-freshness.test.mjs tests/health-ingestion-consistency.test.mjs tests/health-sync-transport.test.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@netlify/plugin-nextjs": "5.16.0"
  }
}
