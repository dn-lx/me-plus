{
  "name": "Multi-agent Codespace | Claude · Codex · Antigravity",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "workspaceFolder": "/workspaces/multi-agent-codespace",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteEnv": {
    "PATH": "/home/node/.local/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/install-agents.sh",
  "postStartCommand": "bash scripts/remote.sh start",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.scrollback": 10000
      }
    }
  }
}
