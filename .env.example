# Public client configuration. These values are intentionally exposed to the relevant client bundle.

# Web client (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mobile client (Expo)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_ME_PLUS_API_URL=http://localhost:3000

# Server-only configuration. Never prefix privileged keys with NEXT_PUBLIC_ or EXPO_PUBLIC_.
# Configure these only in the server/deployment secret store; never commit real values.
SUPABASE_SECRET_KEY=
ME_PLUS_ALLOW_FIXTURE_INGEST=false

# Enable Banking (read-only Open Banking for N26).
# Store the private key exactly as provided by Enable Banking, or with escaped \n newlines.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY=
# Example local callback: http://localhost:3000/api/finance/n26/callback
ENABLE_BANKING_REDIRECT_URL=
# Random secret of at least 32 characters, used only to sign short-lived callback state.
ENABLE_BANKING_STATE_SECRET=
# Separate random server-only secret used by Netlify's scheduled N26 refresher.
N26_SYNC_SCHEDULER_SECRET=
