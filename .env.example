# Public client configuration. These values are intentionally exposed to the relevant client bundle.

# Web client (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mobile client (Expo)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_ME_PLUS_API_URL=http://localhost:3000

# Server-only configuration. Never prefix privileged keys with NEXT_PUBLIC_ or EXPO_PUBLIC_.
# Configure these only in the server/deployment secret store; never commit real values.
SUPABASE_SECRET_KEY=
ME_PLUS_ALLOW_FIXTURE_INGEST=false
